{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vibe-reader",
  "mainBinaryName": "vibe-reader-gui",
  "identifier": "io.github.exec-cmd.vibe-reader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Education",
    "shortDescription": "Desktop book reader with atmosphere and a CLI for AI agents",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
