[Desktop Entry]
Type=Application
Name=vibe-reader (quick view)
Name[ru]=vibe-reader (быстрый просмотр)
Comment=Open a book or a Markdown file without the library
Comment[ru]=Открыть книгу или Markdown-файл без библиотеки
Exec=vibe-reader-gui --lite %f
Icon=vibe-reader
Terminal=false
NoDisplay=true
Categories=Office;Viewer;
MimeType=application/epub+zip;application/x-fictionbook+xml;text/markdown;text/plain;text/html;application/pdf;
